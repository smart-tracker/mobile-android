<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Ствол -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,21 L12,8" />
    <!-- Лист слева (ниже) -->
    <path
        android:fillColor="#000000"
        android:pathData="M12,16 C11,12 8,9.5 4.5,9.5 C4.5,13 7.5,15.8 12,16 Z" />
    <!-- Лист справа (выше) -->
    <path
        android:fillColor="#000000"
        android:pathData="M12,11.5 C13,7.5 16,5 19.5,5 C19.5,8.5 16.5,11.3 12,11.5 Z" />
</vector>
